// GanttLines database schema. Engine rows map 1:1 onto `Row` (see src/rows.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  editor
  viewer
  guest
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  mustChangePassword Boolean   @default(false)
  /// single sign-on account ("<issuer>#<subject>"), once linked
  oidcSubject        String?   @unique
  /// two-factor: the authenticator secret (encrypted; set while enrolling, kept once enabled)
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  /// the last code's time step, so a code can't be used twice
  totpLastStep       Int?
  /// hashes of unused recovery codes
  totpRecovery       String[]  @default([])
  createdAt          DateTime  @default(now())
  sessions           Session[]
  passwordTokens     PasswordToken[]
  resource           Resource?
  commands           CommandLog[]
  shareLinks         ShareLink[]
  comments           Comment[]
  baselines          Baseline[]
}

/// One-time "choose your password" links (invitations, forgot password); only a hash is stored.
model PasswordToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "reset" | "invite"
  purpose   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  /// HMAC-SHA256 of the cookie token (the token itself is never stored)
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  /// signed in with single sign-on (the provider handles two-factor), not a password
  viaSso     Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  avatarColor String
  inactive    Boolean  @default(false)
  userId      String?  @unique @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// where they work: holidays for that location apply to them
  locationId  String?   @db.Uuid
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  timeOff     TimeOff[]
}

/// An office or country that team members belong to; holidays can target it.
model Location {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  /// ISO 3166-1 country code (for public holidays), e.g. "PT"
  country   String?
  /// region within the country, for regional holidays (e.g. "BY" in Germany)
  region    String?
  createdAt DateTime   @default(now())
  resources Resource[]
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// incremented for every applied command
  version    Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  rows       Row[]
  commands   CommandLog[]
  shareLinks ShareLink[]
  comments   Comment[]
  highlights Highlight[]
  baselines  Baseline[]
}

model Row {
  /// client-generated UUID, globally unique
  id            String  @id @db.Uuid
  projectId     String  @db.Uuid
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  parentId      String? @db.Uuid
  position      String
  collapsed     Boolean @default(false)
  // task-only fields (defaults for sections)
  userStart     String?
  /// placed on the afternoon of userStart
  startsAfternoon Boolean @default(false)
  /// working days in half-day steps (0.5, 1, 2.5 …); 0 = milestone
  duration      Float   @default(1)
  /// working days the task really took (informational), when recorded
  actualDuration Float?
  resourceId    String? @db.Uuid
  color         String  @default("blue")
  locked        Boolean @default(false)
  predecessorId String? @db.Uuid
  /// working days in half-day steps
  offset        Float   @default(0)
  description   String  @default("")

  @@index([projectId])
}

/// Singleton (id = 1): instance-wide calendar settings and the instance-scope version counter.
model Settings {
  id              Int   @id @default(1)
  workingWeekdays Int[] @default([1, 2, 3, 4, 5])
  instanceVersion Int   @default(0)
  /// ask GitHub for new releases (admins can switch it off)
  updateCheck     Boolean @default(true)
  /// who must use two-factor to sign in with a password
  requireTwoFactor TwoFactorRequirement @default(off)
}

enum TwoFactorRequirement {
  off
  admins
  everyone
}

model Holiday {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  startDate    String
  endDate      String
  /// true = applies to everyone; otherwise to `resourceIds` and everyone in `locationIds`
  appliesToAll Boolean
  resourceIds  String[] @db.Uuid
  locationIds  String[] @default([]) @db.Uuid
  createdAt    DateTime @default(now())
}

model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startDate  String
  endDate    String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([resourceId])
}

/// Every applied command. Project commands have projectId + project version; instance-scope
/// commands (resources, calendar) have projectId = null and the instance version.
model CommandLog {
  id          Int      @id @default(autoincrement())
  projectId   String?  @db.Uuid
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  commandId   String   @unique @db.Uuid
  actorUserId String?  @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// the share link the change was made through (anonymous visitors, users editing via a link)
  actorLinkId String?  @db.Uuid
  /// display name at the time of the command (kept when the user is deleted)
  actorLabel  String
  name        String
  payload     Json
  changes     Json
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
}

enum LinkAccess {
  anonymous
  authenticated
}

/// A link that opens one project's board. Only an HMAC of the token is stored.
model ShareLink {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @db.Uuid
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash       String     @unique
  access          LinkAccess
  /// false = view only; true = the board can be edited through the link
  collaboration   Boolean    @default(false)
  label           String     @default("")
  createdByUserId String?    @db.Uuid
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByLabel  String
  createdAt       DateTime   @default(now())
  revokedAt       DateTime?

  @@index([projectId])
}

/// A comment on a task. `taskId` is not a foreign key: comments outlive deleted rows (activity history).
model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String    @db.Uuid
  authorUserId    String?   @db.Uuid
  author          User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  /// anonymous share-link visitors (lets them edit their own comments)
  authorVisitorId String?
  authorLabel     String
  body            String
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  @@index([projectId, taskId])
}

/// A highlighted day on a project's chart.
model Highlight {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String
  label     String
  color     String

  @@index([projectId])
}

/// A saved copy of a project's scheduled dates, to compare against later.
model Baseline {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  createdAt       DateTime @default(now())
  createdByUserId String?  @db.Uuid
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByLabel  String
  /// [{ rowId, kind, title, start, end, startsAfternoon, endsMidday }] of every scheduled task at creation time
  snapshot        Json

  @@index([projectId])
}
