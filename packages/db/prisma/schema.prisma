// GanttLines database schema. Engine rows map 1:1 onto `Row` (see src/rows.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  editor
  viewer
  guest
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  sessions           Session[]
  resource           Resource?
  commands           CommandLog[]
  shareLinks         ShareLink[]
  comments           Comment[]
  baselines          Baseline[]
}

model Session {
  /// HMAC-SHA256 of the cookie token (the token itself is never stored)
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  avatarColor String
  inactive    Boolean  @default(false)
  userId      String?  @unique @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  timeOff     TimeOff[]
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// incremented for every applied command (plan 2b)
  version    Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  rows       Row[]
  commands   CommandLog[]
  shareLinks ShareLink[]
  comments   Comment[]
  highlights Highlight[]
  baselines  Baseline[]
}

model Row {
  /// client-generated UUID, globally unique
  id            String  @id @db.Uuid
  projectId     String  @db.Uuid
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  parentId      String? @db.Uuid
  position      String
  collapsed     Boolean @default(false)
  // task-only fields (defaults for sections)
  userStart     String?
  /// working days in half-day steps (0.5, 1, 2.5 …); 0 = milestone
  duration      Float   @default(1)
  /// working days the task really took (informational), when recorded
  actualDuration Float?
  resourceId    String? @db.Uuid
  color         String  @default("blue")
  locked        Boolean @default(false)
  predecessorId String? @db.Uuid
  offset        Int     @default(0)
  description   String  @default("")

  @@index([projectId])
}

/// Singleton (id = 1): instance-wide calendar settings and the instance-scope version counter.
model Settings {
  id              Int   @id @default(1)
  workingWeekdays Int[] @default([1, 2, 3, 4, 5])
  instanceVersion Int   @default(0)
}

model Holiday {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  startDate    String
  endDate      String
  /// true = applies to everyone; otherwise only to `resourceIds`
  appliesToAll Boolean
  resourceIds  String[] @db.Uuid
  createdAt    DateTime @default(now())
}

model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startDate  String
  endDate    String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([resourceId])
}

/// Every applied command. Project commands have projectId + project version; instance-scope
/// commands (resources, calendar) have projectId = null and the instance version.
model CommandLog {
  id          Int      @id @default(autoincrement())
  projectId   String?  @db.Uuid
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  commandId   String   @unique @db.Uuid
  actorUserId String?  @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// the share link the change was made through (anonymous visitors, users editing via a link)
  actorLinkId String?  @db.Uuid
  /// display name at the time of the command (kept when the user is deleted)
  actorLabel  String
  name        String
  payload     Json
  changes     Json
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
}

enum LinkAccess {
  anonymous
  authenticated
}

/// A link that opens one project's board. Only an HMAC of the token is stored.
model ShareLink {
  id              String     @id @default(uuid()) @db.Uuid
  projectId       String     @db.Uuid
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash       String     @unique
  access          LinkAccess
  /// false = view only; true = the board can be edited through the link
  collaboration   Boolean    @default(false)
  label           String     @default("")
  createdByUserId String?    @db.Uuid
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByLabel  String
  createdAt       DateTime   @default(now())
  revokedAt       DateTime?

  @@index([projectId])
}

/// A comment on a task. `taskId` is not a foreign key: comments outlive deleted rows (activity history).
model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String    @db.Uuid
  authorUserId    String?   @db.Uuid
  author          User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  /// anonymous share-link visitors (lets them edit their own comments)
  authorVisitorId String?
  authorLabel     String
  body            String
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  @@index([projectId, taskId])
}

/// A highlighted day on a project's chart.
model Highlight {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String
  label     String
  color     String

  @@index([projectId])
}

/// A saved copy of a project's scheduled dates, to compare against later.
model Baseline {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  createdAt       DateTime @default(now())
  createdByUserId String?  @db.Uuid
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByLabel  String
  /// [{ rowId, title, start, end }] of every scheduled task at creation time
  snapshot        Json

  @@index([projectId])
}
