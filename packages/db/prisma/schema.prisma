// GanttLines database schema. Engine rows map 1:1 onto `Row` (see src/rows.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  editor
  viewer
  guest
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  sessions           Session[]
  resource           Resource?
  commands           CommandLog[]
}

model Session {
  /// HMAC-SHA256 of the cookie token (the token itself is never stored)
  id         String   @id
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  avatarColor String
  inactive    Boolean  @default(false)
  userId      String?  @unique @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  timeOff     TimeOff[]
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// incremented for every applied command (plan 2b)
  version    Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  rows       Row[]
  commands   CommandLog[]
}

model Row {
  /// client-generated UUID, globally unique
  id            String  @id @db.Uuid
  projectId     String  @db.Uuid
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  parentId      String? @db.Uuid
  position      String
  collapsed     Boolean @default(false)
  // task-only fields (defaults for sections)
  userStart     String?
  duration      Int     @default(1)
  resourceId    String? @db.Uuid
  color         String  @default("blue")
  locked        Boolean @default(false)
  predecessorId String? @db.Uuid
  offset        Int     @default(0)
  description   String  @default("")

  @@index([projectId])
}

/// Singleton (id = 1): instance-wide calendar settings and the instance-scope version counter.
model Settings {
  id              Int   @id @default(1)
  workingWeekdays Int[] @default([1, 2, 3, 4, 5])
  instanceVersion Int   @default(0)
}

model Holiday {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  startDate    String
  endDate      String
  /// true = applies to everyone; otherwise only to `resourceIds`
  appliesToAll Boolean
  resourceIds  String[] @db.Uuid
  createdAt    DateTime @default(now())
}

model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startDate  String
  endDate    String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([resourceId])
}

/// Every applied command. Project commands have projectId + project version; instance-scope
/// commands (resources, calendar) have projectId = null and the instance version.
model CommandLog {
  id          Int      @id @default(autoincrement())
  projectId   String?  @db.Uuid
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  commandId   String   @unique @db.Uuid
  actorUserId String?  @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// display name at the time of the command (kept when the user is deleted)
  actorLabel  String
  name        String
  payload     Json
  changes     Json
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
}
