# ── GanttLines settings: copy to .env and fill in ────────────────────────

# The bundled PostgreSQL. To use your own database instead, delete this line and set DATABASE_URL.
COMPOSE_PROFILES=bundled-db
# Password for the bundled database (letters and digits), e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Your own PostgreSQL (13 or newer), instead of the bundled one:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/ganttlines?sslmode=require

# Signs sessions; at least 32 characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# The first admin account, created on the first start (later changes here have no effect).
# Leave these empty to create it in the browser instead, with the setup code from the log.
# With single sign-on (OIDC_* below), ADMIN_EMAIL alone is enough: whoever first signs in with
# that email becomes the admin.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Email (invitations, "forgot your password?"). Any SMTP service works (your mail provider,
# Postmark, SendGrid, Amazon SES, Mailgun …). Port 587 uses STARTTLS; 465 uses TLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=GanttLines <plan@example.com>

# Single sign-on with an OpenID Connect provider (Google, Microsoft, Keycloak, Authentik …).
# Register this redirect URL with the provider: <PUBLIC_URL>/api/auth/oidc/callback
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Google
# Only these email domains (comma-separated; empty = any):
# OIDC_ALLOWED_DOMAINS=yourcompany.com
# Create accounts for people signing in for the first time (otherwise an admin adds them first):
# OIDC_AUTO_CREATE=false
# OIDC_DEFAULT_ROLE=viewer

# The address people open in their browser (behind a reverse proxy: its https:// address)
PUBLIC_URL=http://localhost:3000

# Where the app listens on this machine. 127.0.0.1 = this computer only; 0.0.0.0 = your network too.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Behind a reverse proxy: how many proxies to trust for client addresses (e.g. 1)
# TRUST_PROXY=1

# A backup is taken automatically before any database migration (on upgrade). Set to false to skip.
# BACKUP_BEFORE_MIGRATE=true

# Running several copies sharing one database (see "Running several copies" in the README):
# CLUSTER=postgres on every copy. Unset = one server (the default).
# CLUSTER=
# Milliseconds of grace for load balancers when a copy stops (default 0, or 5000 with CLUSTER=postgres)
# SHUTDOWN_DELAY_MS=

# Which version to run: latest, a major (1), a minor (1.4) or an exact version (1.4.0)
# GP_TAG=latest
# GP_IMAGE=ghcr.io/d-martins/ganttlines
